{
  "name": "hermes-channels",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Slack-style channels where a crew of persistent Hermes agents work together \u2014 a plugin for Hermes Agent (Desktop and web dashboard).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goktugvatandas/hermes-channels.git"
  },
  "homepage": "https://github.com/goktugvatandas/hermes-channels#readme",
  "bugs": {
    "url": "https://github.com/goktugvatandas/hermes-channels/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/e2e/crew.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:py": "pytest -q",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package": "node scripts/package.mjs"
  },
  "peerDependencies": {
    "react": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "postcss": "^8.5.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
